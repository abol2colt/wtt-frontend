{
  "name": "wtt-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:proxy": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "ng build --configuration development --progress=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.angular','dist','out-tsc','coverage']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "^4.1.0-0",
    "echarts": "^6.0.0",
    "ngx-echarts": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.15",
    "postcss": "^8.5.13",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "description": "Angular 21 frontend for the WTT work tracking dashboard.",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10"
  }
}
